  "cards": [
    {
      "dot": "cyan",
      "title": "Cache hit",
      "items": [
        "One manifest keys both the FAISS cache and the OpenSearch generation",
        "Unchanged documents skip embedding and bulk indexing"
      ]
    },
    {
      "dot": "amber",
      "title": "Cache miss",
      "items": [
        "Any added, removed, or edited file changes the manifest",
        "FAISS saves atomically; the alias moves only once the new generation is searchable"
      ]
    },
    {
      "dot": "rose",
      "title": "Warm ahead",
      "items": [
        "python app.py --warm-index runs this flow without answering",
