  "cards": [
    {
      "dot": "cyan",
      "title": "Question path",
      "items": [
        "GENERAL questions are answered from the doc_files summary",
        "SPECIFIC questions are rephrased, then answered by RetrievalQA"
      ]
    },
    {
      "dot": "amber",
      "title": "Retriever modes",
      "items": [
        "hybrid is the default; RETRIEVER_MODE or --retriever selects faiss or opensearch",
        "hybrid merges both with 0.5 / 0.5 rank fusion"
      ]
    },
    {
      "dot": "emerald",
      "title": "Index cache",
      "items": [
        "One SHA-256 manifest reuses the FAISS index and the OpenSearch generation",
        "python app.py --warm-index builds indexes before users arrive"
      ]
    }
