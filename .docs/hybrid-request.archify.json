  "cards": [
    {
      "dot": "cyan",
      "title": "Built once",
      "items": [
        "Both indexes are built at startup from the same 500/50 chunks",
        "st.cache_resource reuses the chains on every question"
      ]
    },
    {
      "dot": "amber",
      "title": "Why hybrid",
      "items": [
        "FAISS matches meaning; BM25 matches exact terms like OSPF or RADIUS",
        "Only the FAISS search calls OpenAI; BM25 needs no embeddings"
      ]
    },
    {
      "dot": "rose",
      "title": "Trade-off",
      "items": [
        "Better recall, not lower latency: both searches run one after the other",
        "Enabled only when RETRIEVER_MODE=hybrid"
      ]
    }
  ]
